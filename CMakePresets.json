{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-tests",
      "displayName": "Host tests (native compiler, Unity + ctest)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MOTO_BUILD_HOST_TESTS": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer"
      }
    },
    {
      "name": "host-coverage",
      "displayName": "Host tests with gcov line/branch coverage (no sanitizers)",
      "inherits": "host-tests",
      "binaryDir": "${sourceDir}/build/host-coverage",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -O0"
      }
    },
    {
      "name": "host-tsan",
      "displayName": "Host tests under ThreadSanitizer (the lock-free exchange, D-065)",
      "inherits": "host-tests",
      "binaryDir": "${sourceDir}/build/host-tsan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -O1 -g"
      }
    },
    {
      "name": "target-m7-debug",
      "displayName": "Cortex-M7 cross build (Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/target-m7-debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "target-m7-release",
      "displayName": "Cortex-M7 cross build (Release)",
      "inherits": "target-m7-debug",
      "binaryDir": "${sourceDir}/build/target-m7-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests"
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage"
    },
    {
      "name": "host-tsan",
      "configurePreset": "host-tsan"
    },
    {
      "name": "target-m7-debug",
      "configurePreset": "target-m7-debug"
    },
    {
      "name": "target-m7-release",
      "configurePreset": "target-m7-release"
    }
  ],
  "testPresets": [
    {
      "name": "host-tests",
      "configurePreset": "host-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-tsan",
      "configurePreset": "host-tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "name": "test_snapshot|test_alive|test_comms_ekf"
        }
      }
    },
    {
      "name": "host-coverage",
      "configurePreset": "host-coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
